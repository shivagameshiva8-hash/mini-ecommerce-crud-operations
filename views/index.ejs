<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini E-commerce</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h3>All Products !</h3>

    <% for(let product of products) { %>
        <!-- creting new product -->
         <form method="GET" action="/products/new">
            <button>Create New product</button>
         </form>
         <br/>
         




        <div class="product">
            <p><%=product.description%></p>

            <form method="GET" action="/products/<%=product._id%>/edit">
                    <button>Edit</button>
            </form>
                <br>


                <form method="POST" 
                        action="/products/<%=product._id%>/delete/?_method=DELETE"
                         onsubmit="return confirm('Are you sure you want to delete this chat?');">
                    <button>Delete</button>
         </form>

        </div>
        <br>
        <p><i><%=product.price%></i></p>

        <br>
        <div class="name">
             <p><i><%=product.name%></i></p>
        </div>
       
        <hr><hr>
   <% } %>
    
</body>
</html>